# AI R&D Council — Environment Variables
# Copy this to .env and fill in your values

# LLM provider: 'ollama' (free, local) or 'openai' (paid, cloud)
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b

# OpenAI key (used when LLM_PROVIDER=openai — fallback only)
OPENAI_API_KEY=sk-...

# Optional: Email delivery (Gmail SMTP or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: SMS notifications via Twilio
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Optional: ntfy push notifications
# Install the ntfy app on your phone and subscribe to your topic
# Default topic: fbf-rd-council
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=fbf-rd-council
